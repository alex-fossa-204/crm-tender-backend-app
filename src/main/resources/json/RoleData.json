{
    "version": "1.0",
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Метаданные тендера",
    "type": "object",
    "required": [
        "rqUid",
        "rqTm"
    ],
    "additionalProperties": false,
    "properties": {
        "role": {
            "description": "Имя роли в системе",
            "type": "string",
            "maxLength": 32,
            "pattern": "^([0-9]|[a-f]|[A-F]){32}$"
        }
    }
}
