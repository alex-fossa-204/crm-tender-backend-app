{
  "version": "1.0",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Данные о позиции сотрудника в компании",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Название команды",
      "type": "string",
      "maxLength": 20
    },
    "position": {
      "type": "object",
      "$ref": "PositionData.json"
    },
    "allocation": {
      "description": "Обязательное время, уделяемое работе в команде",
      "type": "string",
      "maxLength": 20
    },
    "startDate": {
      "description": "Дата старта работы в команде",
      "type": "string",
      "maxLength": 20
    },
    "endDate": {
      "description": "Дата завершения работы в команде",
      "type": "string",
      "maxLength": 20
    },
    "leader": {
      "description": "Данные о руководителе департамента",
      "type": "object",
      "additionalProperties": false,
      "$ref": "UserData.json"
    },
    "fidbacks": {
      "type": "array",
      "uniqueItems": true,
      "additionalItems": false,
      "minItems": 0,
      "items": {
        "description": "Данные о фидбеках сотрудника в компании",
        "type": "object",
        "additionalProperties": false,
        "$ref": "FidbackData.json"
      }
    }
  }
}