{
  "version": "1.0",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "description": "Данные о позиции сотрудника в компании",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Полное название департамента",
      "type": "string",
      "maxLength": 20
    },
    "shortcut": {
      "description": "Сокращенное имя департамента",
      "type": "string",
      "maxLength": 20
    },
    "position": {
      "type": "object",
      "$ref": "PositionData.json"
    },
    "leader": {
      "description": "Данные о руководителе департамента",
      "type": "object",
      "additionalProperties": false,
      "$ref": "UserData.json"
    }
  }
}